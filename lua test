    local function addBind(parent, name, current, onChanged, onPress, flag)
        local cur = current
        if cur == nil or cur == "" or cur == "None" then cur = "Unknown" end
        return parent:CreateBind({
            Name = name,
            CurrentBind = cur,
            HoldToInteract = false,
            Callback = function(state)
