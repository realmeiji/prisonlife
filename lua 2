local function listConfigs()
    local out = {}
    local ok, files = pcall(function() return listfiles(DIR_NAME .. "/" .. tostring(game.PlaceId)) end)
    if not ok or not files then return out end
    for i = 1, #files do
        local f = files[i]
        if f:sub(-4) == ".lua" then
            local pos = f:find(".lua", 1, true)
            local start = pos
            local ch = f:sub(pos, pos)
            while ch ~= "/" and ch ~= "\\" and ch ~= "" do
                pos = pos - 1
                ch = f:sub(pos, pos)
            end
            if ch == "/" or ch == "\\" then
                table.insert(out, f:sub(pos + 1, start - 1))
            end
        end
    end
    return out
end

