local ICO = {
    on = "+", off = "x", gear = "*", info = "i", warn = "!",
    success = "+", error = "x", save = "v", load = "^",
    accent = "*", boot = ">",
}

local notifCount = 0
local NOTIF_STAGGER = 0.04

local function icoFor(text)
    local s = string.lower(text)
    if s:find("enabled") then return ICO.on end
    if s:find("disabled") then return ICO.off end
    if s:find("loaded") then return ICO.load end
    if s:find("saved") or s:find("created") then return ICO.save end
    if s:find("accent") then return ICO.accent end
    if s:find("starting") or s:find("spent hub") then return ICO.boot end
    if s:find("fail") or s:find("error") then return ICO.error end
    return ICO.info
end

local function notify(text, color)
    color = color or T.ACCENT
    notifCount = notifCount + 1
    local order = notifCount
    task.delay((order - 1) * NOTIF_STAGGER, function()
        local LIFE = 3.2
        local paused = false
        local left = LIFE
        local lastT = tick()

        local wrap = Instance.new("Frame", notifWrap)
        wrap.Size = UDim2.new(1, 0, 0, 44)
        wrap.BackgroundTransparency = 1
        wrap.ZIndex = 501

        local shadowCard = Instance.new("Frame", wrap)
        shadowCard.Size = UDim2.new(1, 0, 1, 0)
        shadowCard.Position = UDim2.new(0, 2, 0, 2)
        shadowCard.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        shadowCard.BackgroundTransparency = 0.6
        shadowCard.BorderSizePixel = 0
        shadowCard.ZIndex = 501
        Instance.new("UICorner", shadowCard).CornerRadius = UDim.new(0.15, 0)

        local card = Instance.new("Frame", wrap)
        card.Size = UDim2.new(1, 0, 1, 0)
        card.BackgroundColor3 = T.BG_OPT
        card.BackgroundTransparency = 0.05
        card.BorderSizePixel = 0
        card.ZIndex = 502
        Instance.new("UICorner", card).CornerRadius = UDim.new(0.15, 0)

        local stroke = Instance.new("UIStroke", card)
        stroke.Color = color
        stroke.Thickness = 1
        stroke.Transparency = 0.3

        local glow = Instance.new("UIStroke", card)
        glow.Color = color
        glow.Thickness = 3
        glow.Transparency = 0.85
        Instance.new("UICorner", glow).CornerRadius = UDim.new(0.15, 0)

        local sideBar = Instance.new("Frame", card)
        sideBar.Size = UDim2.new(0, 3, 1, -8)
        sideBar.Position = UDim2.new(0, 4, 0, 4)
        sideBar.BackgroundColor3 = color
        sideBar.BorderSizePixel = 0
        sideBar.ZIndex = 503
        Instance.new("UICorner", sideBar).CornerRadius = UDim.new(1, 0)

        local dot = Instance.new("Frame", card)
        dot.Size = UDim2.new(0, 22, 0, 22)
        dot.Position = UDim2.new(0, 12, 0.5, -11)
        dot.BackgroundColor3 = color
        dot.BackgroundTransparency = 0.15
        dot.BorderSizePixel = 0
        dot.ZIndex = 503
        Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

        local dotLbl = Instance.new("TextLabel", dot)
        dotLbl.Size = UDim2.new(1, 0, 1, 0)
        dotLbl.BackgroundTransparency = 1
        dotLbl.Text = icoFor(text)
        dotLbl.TextColor3 = Color3.fromRGB(15, 15, 18)
        dotLbl.Font = Enum.Font.GothamBold
        dotLbl.TextSize = 13
        dotLbl.ZIndex = 504

        local lbl = Instance.new("TextLabel", card)
        lbl.Size = UDim2.new(1, -50, 1, -6)
        lbl.Position = UDim2.new(0, 42, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = text
        lbl.TextColor3 = T.TEXT_STRONG
        lbl.Font = Enum.Font.GothamMedium
        lbl.TextSize = 12
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.TextYAlignment = Enum.TextYAlignment.Center
        lbl.ZIndex = 503

        local track = Instance.new("Frame", card)
        track.Size = UDim2.new(1, -12, 0, 2)
        track.Position = UDim2.new(0, 6, 1, -5)
        track.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
        track.BorderSizePixel = 0
        track.ZIndex = 503
        Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

        local fill = Instance.new("Frame", track)
        fill.Size = UDim2.new(1, 0, 1, 0)
        fill.BackgroundColor3 = color
        fill.BorderSizePixel = 0
        fill.ZIndex = 504
        Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

        wrap.Position = UDim2.new(1.15, 0, 0, 0)
        wrap.BackgroundTransparency = 1
        card.BackgroundTransparency = 1
        shadowCard.BackgroundTransparency = 1
        lbl.TextTransparency = 1
        dotLbl.TextTransparency = 1
        sideBar.BackgroundTransparency = 1

        TweenService:Create(wrap, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = UDim2.new(0.02, 0, 0, 0)}):Play()
        task.delay(0.2, function()
            TweenService:Create(wrap, TweenInfo.new(0.1, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}):Play()
        end)

        TweenService:Create(card, TweenInfo.new(0.2), {BackgroundTransparency = 0.05}):Play()
        TweenService:Create(shadowCard, TweenInfo.new(0.2), {BackgroundTransparency = 0.6}):Play()
        TweenService:Create(lbl, TweenInfo.new(0.2), {TextTransparency = 0}):Play()
        TweenService:Create(dotLbl, TweenInfo.new(0.2), {TextTransparency = 0}):Play()
        TweenService:Create(sideBar, TweenInfo.new(0.2), {BackgroundTransparency = 0}):Play()

        local dying = false
        local function close()
            if dying then return end
            dying = true
            TweenService:Create(wrap, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Position = UDim2.new(1.15, 0, 0, 0)}):Play()
            TweenService:Create(card, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
            TweenService:Create(shadowCard, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
            TweenService:Create(lbl, TweenInfo.new(0.2), {TextTransparency = 1}):Play()
            TweenService:Create(dotLbl, TweenInfo.new(0.2), {TextTransparency = 1}):Play()
            TweenService:Create(sideBar, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
            TweenService:Create(fill, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
            task.wait(0.25)
            pcall(function() wrap:Destroy() end)
        end

        card.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then close() end
        end)

        card.MouseEnter:Connect(function()
            paused = true
            TweenService:Create(stroke, TweenInfo.new(0.15), {Transparency = 0}):Play()
            TweenService:Create(glow, TweenInfo.new(0.15), {Transparency = 0.6}):Play()
        end)

        card.MouseLeave:Connect(function()
            paused = false
            TweenService:Create(stroke, TweenInfo.new(0.15), {Transparency = 0.3}):Play()
            TweenService:Create(glow, TweenInfo.new(0.15), {Transparency = 0.85}):Play()
        end)

        task.spawn(function()
            while not dying do
                task.wait(0.05)
                local now = tick()
                local dt = now - lastT
                lastT = now
                if not paused then
                    left = left - dt
                    if left <= 0 then close() break end
                    fill.Size = UDim2.new(math.clamp(left / LIFE, 0, 1), 0, 1, 0)
                end
            end
        end)
    end)
end

