-- roll once per 0.15s so hit chance doesn't flicker every frame
local lastRoll, lastResult = 0, false
local function rollChance(pct)
    local now = tick()
    if now - lastRoll < 0.15 then return lastResult end
    lastRoll = now
    pct = math.floor(pct)
    local r = Random.new()
    lastResult = (math.floor(r:NextNumber(0, 1) * 100) / 100) <= pct / 100
    return lastResult
end

