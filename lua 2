    Instance.new("UICorner", pillGlow).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame", pill)
    knob.Size = UDim2.new(0, 12, 0, 12)
    knob.Position = default and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)
    knob.BackgroundColor3 = Color3.fromRGB(250, 250, 250)
    knob.BorderSizePixel = 0
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local on = default
    btn.MouseButton1Click:Connect(function()
        on = not on
        TweenService:Create(knob, TweenInfo.new(0.15, Enum.EasingStyle.Quart), {Position = on and UDim2.new(1, -14, 0.5, -6) or UDim2.new(0, 2, 0.5, -6)}):Play()
        TweenService:Create(pill, TweenInfo.new(0.15), {BackgroundColor3 = on and T.ACCENT or Color3.fromRGB(48, 48, 56)}):Play()
        TweenService:Create(pillGlow, TweenInfo.new(0.15), {Transparency = on and 0.4 or 1}):Play()
        TweenService:Create(glow, TweenInfo.new(0.18), {Transparency = on and 0.7 or 1}):Play()
