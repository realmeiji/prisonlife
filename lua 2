local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(...)
    local Method = getnamecallmethod()
    local Args = {...}
    local self = Args[1]
    local rolled = rollChance(SA.HitChance)

    if SA.Enabled and self == workspace and not checkcaller() and rolled then
        if Method == "FindPartOnRayWithIgnoreList" and SA.SilentAimMethod == Method then
            if checkRayArgs(Args, RayArgSpecs.FindPartOnRayWithIgnoreList) then
                local r = Args[2]
                local hit = closestPart()
                if hit then
                    Args[2] = Ray.new(r.Origin, dirFrom(r.Origin, hit.Position))
                    return oldNamecall(table.unpack(Args))
                end
            end
        elseif Method == "FindPartOnRayWithWhitelist" and SA.SilentAimMethod == Method then
            if checkRayArgs(Args, RayArgSpecs.FindPartOnRayWithWhitelist) then
                local r = Args[2]
                local hit = closestPart()
                if hit then
                    Args[2] = Ray.new(r.Origin, dirFrom(r.Origin, hit.Position))
                    return oldNamecall(table.unpack(Args))
                end
            end
        elseif (Method == "FindPartOnRay" or Method == "findPartOnRay") and SA.SilentAimMethod:lower() == Method:lower() then
            if checkRayArgs(Args, RayArgSpecs.FindPartOnRay) then
                local r = Args[2]
                local hit = closestPart()
                if hit then
                    Args[2] = Ray.new(r.Origin, dirFrom(r.Origin, hit.Position))
                    return oldNamecall(table.unpack(Args))
                end
            end
        elseif Method == "Raycast" and SA.SilentAimMethod == Method then
            if checkRayArgs(Args, RayArgSpecs.Raycast) then
                local o = Args[2]
                local hit = closestPart()
                if hit then
                    Args[3] = dirFrom(o, hit.Position)
                    return oldNamecall(table.unpack(Args))
                end
            end
        end
    end
    return oldNamecall(...)
end))

