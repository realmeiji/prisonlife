local function canSee(plr)
    local c, lc = plr.Character, LP.Character
    if not (c and lc) then return false end
    local root = FindChild(c, SA.TargetPart) or FindChild(c, "HumanoidRootPart")
    if not root then return false end
    local points = {root.Position, lc, c}
    local ignores = {lc, c}
    return #PartsObscuring(Cam, points, ignores) == 0
end

local function teamColor(plr)
    local ok, col = pcall(function()
        if plr.Team and plr.Team.TeamColor then return plr.Team.TeamColor.Color end
        local ch = plr.Character
        if ch then
            local bc = ch:FindFirstChildOfClass("BodyColors")
            if bc then return bc.HeadColor3 end
        end
        return Color3.fromRGB(255, 182, 193)
    end)
    if ok and col then return col end
    return Color3.fromRGB(255, 182, 193)
end

local TEAM_NAMES = {
    Guard    = {"Guards", "Guard", "Police", "Cop", "Cops"},
    Inmate   = {"Inmates", "Inmate", "Prisoner", "Prisoners"},
    Criminal = {"Criminals", "Criminal", "Convict", "Convicts"},
}

local function matchesTeamName(n, kind)
    for _, v in ipairs(TEAM_NAMES[kind]) do
        if n == v then return true end
    end
    return false
end

local function teamKind(plr)
    if not plr.Team then
        local c = plr.Character
        if c then
            local a = c:GetAttribute("Team") or c:GetAttribute("Role")
            if type(a) == "string" then
                if matchesTeamName(a, "Guard") then return "Guard" end
                if matchesTeamName(a, "Inmate") then return "Inmate" end
                if matchesTeamName(a, "Criminal") then return "Criminal" end
            end
        end
        return nil
    end
    local n = plr.Team.Name
    if matchesTeamName(n, "Guard") then return "Guard" end
    if matchesTeamName(n, "Inmate") then return "Inmate" end
    if matchesTeamName(n, "Criminal") then return "Criminal" end
    return nil
end

local function flags(plr)
    local c = plr.Character
    if not c then return false, false end
    local ok1, h = pcall(function() return c:GetAttribute("Hostile") end)
    local ok2, t = pcall(function() return c:GetAttribute("Trespassing") end)
    return (ok1 and h == true), (ok2 and t == true)
end

local function teamOk(plr)
    local kind = teamKind(plr)

    local byTeam = true
    if kind == "Guard" and not SA.TargetCop then byTeam = false end
    if kind == "Inmate" and not SA.TargetInmate then byTeam = false end
    if kind == "Criminal" and not SA.TargetCriminal then byTeam = false end

    local byFlag = false
    local myKind = teamKind(LP)
    if (kind == "Guard" or kind == "Criminal") and myKind == "Inmate" then
        local hostile, trespass = flags(plr)
        if SA.TargetHostile and hostile then byFlag = true end
        if SA.TargetTrespassing and trespass then byFlag = true end
    end

    local teamFilter = SA.TargetCop or SA.TargetInmate or SA.TargetCriminal
    local flagFilter = SA.TargetHostile or SA.TargetTrespassing
    if not teamFilter and not flagFilter then return true end

    local hitTeam = (kind == "Guard" and SA.TargetCop)
                 or (kind == "Inmate" and SA.TargetInmate)
                 or (kind == "Criminal" and SA.TargetCriminal)

    return (byTeam and hitTeam) or byFlag
end

local function closestPart()
    if not SA.TargetPart then return end
    local best, bestD

    for _, plr in next, GetPlayers(Players) do
        if plr == LP then continue end
        if SA.TeamCheck and plr.Team == LP.Team then continue end
        if not teamOk(plr) then continue end

        local c = plr.Character
        if not c then continue end
        if SA.VisibleCheck and not canSee(plr) then continue end

        local root = FindChild(c, "HumanoidRootPart")
        local hum = FindChild(c, "Humanoid")
        if not root or not hum or hum.Health <= 0 then continue end

        local sp, on = onScreenPos(root.Position)
        if not on then continue end

        local d = (mousePos() - sp).Magnitude
        if d <= (bestD or SA.FOVRadius or 2000) then
            best = (SA.TargetPart == "Random" and c[AIM_PARTS[math.random(1, #AIM_PARTS)]]) or c[SA.TargetPart]
            bestD = d
        end
    end
    return best
end

-- esp cache. one drawing set per player, reused.
local esp = {}
local ESP_TICK = 1 / 30
local HL_TICK = 0.1
local LOCK_TICK = 0.1
local CULL = 1.2

local lastESP, lastHL, lastLock = 0, 0, 0
local lockedChar = nil

local function isLocked(ch)
    local now = tick()
    if now - lastLock >= LOCK_TICK then
        lastLock = now
        local cur = closestPart()
        lockedChar = (cur and cur.Parent) or nil
    end
    return lockedChar == ch
end

local function mkESP(plr)
    local d = {
        name   = Drawing.new("Text"),
        hpBack = Drawing.new("Line"),
        hpBar  = Drawing.new("Line"),
        trace  = Drawing.new("Line"),
    }
    d.name.Size = 13
    d.name.Center = true
    d.name.Outline = true
    d.name.Color = Color3.fromRGB(255, 255, 255)
    d.name.Visible = false

    d.hpBack.Thickness = 3
    d.hpBack.Color = Color3.fromRGB(30, 30, 30)
    d.hpBack.Visible = false

    d.hpBar.Thickness = 3
    d.hpBar.Color = Color3.fromRGB(80, 255, 100)
    d.hpBar.Visible = false

    d.trace.Thickness = 1
    d.trace.Color = Color3.fromRGB(255, 255, 255)
    d.trace.Visible = false

    esp[plr] = d
    return d
end

local function killESP(plr)
    local d = esp[plr]
    if not d then return end
    for k, obj in pairs(d) do
        if k ~= "lastUpdate" then
            local t = typeof(obj)
            if t == "userdata" or t == "table" then
                pcall(function() obj:Remove() end)
            end
        end
    end
    esp[plr] = nil
end

Players.PlayerRemoving:Connect(function(p) killESP(p) end)

local function hideESP(d)
    if d.name.Visible then d.name.Visible = false end
    if d.hpBack.Visible then d.hpBack.Visible = false end
    if d.hpBar.Visible then d.hpBar.Visible = false end
    if d.trace.Visible then d.trace.Visible = false end
end

local function tickESP()
    local now = tick()
    if now - lastESP < ESP_TICK then return end
    lastESP = now

    local canHL = (now - lastHL) >= HL_TICK
    if canHL then lastHL = now end

    local camPos = Cam.CFrame.Position
    local vp = Cam.ViewportSize
    local cx, vpy = vp.X / 2, vp.Y
    local maxD = SA.ESP_MaxDistance * CULL
    local enabled = SA.ESP_Enabled

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local d = esp[plr]
        local c = plr.Character

        if not enabled then
            if d then hideESP(d) end
            if canHL and c then
                local hl = c:FindFirstChild("SpentHubHL")
                if hl then hl:Destroy() end
            end
            continue
        end

        if not c then
            if d then hideESP(d) end
            continue
        end

        local hrp = c:FindFirstChild("HumanoidRootPart")
        local hum = c:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then
            if d then hideESP(d) end
            continue
        end

        local dist = (camPos - hrp.Position).Magnitude
        if dist > maxD then
            if d then hideESP(d) end
            if canHL then
                local hl = c:FindFirstChild("SpentHubHL")
                if hl then hl:Destroy() end
            end
            continue
        end

        if not d then d = mkESP(plr) end

        local head = c:FindFirstChild("Head") or hrp
        local sh, on = W2VP(Cam, head.Position + Vector3.new(0, 1.5, 0))
        if not on then hideESP(d) continue end

        if SA.ESP_Name then
            if not d.name.Visible then d.name.Visible = true end
            d.name.Text = plr.DisplayName
            d.name.Position = Vector2.new(sh.X, sh.Y - 20)
            d.name.Color = SA.ESP_NameColor
        elseif d.name.Visible then d.name.Visible = false end

        if SA.ESP_Health then
            local topY = sh.Y - 32
            if not d.hpBack.Visible then d.hpBack.Visible = true end
            if not d.hpBar.Visible then d.hpBar.Visible = true end
            d.hpBack.From = Vector2.new(sh.X - 28, topY)
            d.hpBack.To   = Vector2.new(sh.X + 28, topY)
            local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            d.hpBar.From = Vector2.new(sh.X - 28, topY)
            d.hpBar.To   = Vector2.new(sh.X - 28 + 56 * pct, topY)
            d.hpBar.Color = SA.ESP_HPColor
        else
            if d.hpBack.Visible then d.hpBack.Visible = false end
            if d.hpBar.Visible then d.hpBar.Visible = false end
        end

        if SA.ESP_Trace then
            if not d.trace.Visible then d.trace.Visible = true end
            d.trace.From = Vector2.new(cx, vpy)
            d.trace.To   = Vector2.new(sh.X, sh.Y)
            local tc = SA.ESP_Team and teamColor(plr) or SA.ESP_TraceColor
            if d.trace.Color ~= tc then d.trace.Color = tc end
        elseif d.trace.Visible then d.trace.Visible = false end

        if canHL then
            if SA.ESP_Highlight then
                local hl = c:FindFirstChild("SpentHubHL")
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "SpentHubHL"
                    hl.Adornee = c
                    hl.FillTransparency = 1
                    hl.OutlineTransparency = 0
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent = c
                end
                local want
                if isLocked(c) then want = LOCK_COL
                elseif SA.ESP_Team then want = teamColor(plr)
                else want = SA.ESP_HighlightColor end
                if hl.OutlineColor ~= want then hl.OutlineColor = want end
            else
                local hl = c:FindFirstChild("SpentHubHighlight")
                if hl then hl:Destroy() end
            end
        end
    end
end

